%% Referencias de código (no se renderizan en el PNG, solo para mantenimiento futuro)
%% Viene de: docs/schemes/flowcharts/obstacles/mermaid/flujo-parte1-conduccion.mmd (última vuelta completada)
%% ParkController: platform/robot/src/navigation/maneuvers/parking/
%%   activación: core_navigator.py (_should_engage_parking) -- radio 0.45 m (ARC_RADIUS,
%%     platform/shared/src/shared/config/navigation_tuning/waypoint.py), reutilizado como
%%     distancia de espera al punto de staging del ParkController
%%   STAGE: ParkController._handle_stage(); pos_reach_dist_m = 0.04 m, speed = 0.12 m/s
%%   reposicionamiento: _pursue_with_reposition() / _start_reposition()
%%   ENTER: ParkController._handle_enter(); wall_standoff_m = 0.05 m, marker_standoff_m = 0.01 m
%%   DONE: _footprint_inside() + comparación de yaw contra zone.target_yaw
%%   -- valores en platform/shared/config/navigation/parking/parking.toml
%% Chequeo de seguridad 360° durante el estacionamiento: core_navigator.py (_handle_finish)

flowchart TD
    Start(["Se completaron<br/>las 3 vueltas"]) --> EngageCheck{"¿Está en el corredor del<br/>estacionamiento y ya cerca<br/>(a 0.45 m) del punto<br/>de espera?"}
    EngageCheck -- "No" --> KeepDriving(["Sigue conduciendo con<br/>normalidad (ver Parte 1)"])
    EngageCheck -- "Sí" --> Stage

    subgraph FASE_STAGE["Acercamiento (STAGE)"]
        Stage["Avanza en línea recta<br/>hacia el punto de espera,<br/>justo antes del hueco"] --> StageReach{"¿Llegó a menos<br/>de 4 cm del punto<br/>de espera?"}
        StageReach -- "No: el volante se saturó<br/>o el objetivo quedó detrás" --> Reposition["Retrocede y<br/>se reacomoda"]
        Reposition --> Stage
    end

    StageReach -- "Sí" --> Enter

    subgraph FASE_ENTER["Entrada al hueco (ENTER)"]
        Enter["Avanza hacia el centro<br/>del hueco de estacionamiento"] --> Breach{"¿Tocaría la pared<br/>o un poste de<br/>la señalización?"}
        Breach -- "Sí" --> GiveUp["Se detiene donde está:<br/>prioriza no chocar sobre<br/>completar el estacionamiento"]
        Breach -- "No" --> Inside{"¿Ya quedó completamente<br/>dentro del hueco y<br/>alineado con la pared?"}
        Inside -- "No" --> Enter
    end

    Inside -- "Sí" --> Done["Estacionamiento<br/>completado"]

    GiveUp --> Finish
    Done --> Finish

    Finish["Se detiene por completo.<br/>Mientras maniobra, si el espacio<br/>libre alrededor (360°) baja del<br/>margen de seguridad, frena<br/>por precaución"] --> End(["Carrera terminada"])
