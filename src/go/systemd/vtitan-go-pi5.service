[Unit]
Description=vTitan Go (Pi 5) — Camera Capture
# No network-online.target: same reasoning as vtitan-pi5.service -- nothing this
# unit drives needs WiFi to start; telemetry/bridge are best-effort and must
# never gate the robot.
# A Pi 5 reboot power-cycles the Zero too (same USB gadget cable), so every Pi 5
# boot is a simultaneous cold boot of both boards; without the gadget-link wait
# this unit's own startup races link re-enumeration. Bounded (55s) and
# never fails/blocks startup on its own -- see wait-for-gadget-link.sh.
#
# NOT vtitan-lidar.service: that is Python's OWN RPLIDAR driver, which owns
# the same serial port Go's vtitan-go-lidar.service does -- the two cannot
# run together. This unit is camera-capture only and needs neither; the
# navigator/LIDAR/IMU pieces are their own sibling units
# (vtitan-go-navigator.service, vtitan-go-lidar.service, vtitan-go-imu.service).
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
User=__TARGET_USER__
Group=__TARGET_USER__
WorkingDirectory=/opt/vtitan-go
EnvironmentFile=-/opt/vtitan-go/.env
ExecStartPre=/bin/bash __TARGET_HOME__/vtitan/src/python/scripts/provisioning/wait-for-gadget-link.sh
ExecStart=/opt/vtitan-go/bin/pi5 --config-root=/opt/vtitan-go
Restart=on-failure
RestartSec=5
ExecStop=/usr/bin/kill -SIGINT $MAINPID
TimeoutStopSec=10
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
