{
  "include": ["."],
  "exclude": ["**/node_modules", "**/__pycache__", ".pixi"],
  "venvPath": ".pixi/envs",
  "venv": "default",
  "typeCheckingMode": "off",
  "useLibraryCodeForTypes": true,
  "reportMissingTypeStubs": false,
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["./.pixi/envs/default/lib/python3.12/site-packages"],
    },
  ],
}
