[Unit]
Description=vTitan — Go Telemetry Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=__TARGET_USER__
Group=__TARGET_USER__
WorkingDirectory=__TARGET_HOME__/vtitan/apps/backend
ExecStart=__TARGET_HOME__/vtitan/apps/backend/bin/server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
