[Unit]
Description=vTitan — Track Navigator (race)
# The navigator needs /scan, /imu/data and /vision/detections, all published by
# vtitan-pi5.service. Wants (not Requires): if that unit is restarted the
# navigator holds harmlessly rather than being torn down with it.
Wants=vtitan-pi5.service
After=vtitan-pi5.service
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
User=__TARGET_USER__
Group=__TARGET_USER__
WorkingDirectory=__TARGET_HOME__/vtitan/src/python
Environment=PATH=__TARGET_HOME__/.pixi/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-__TARGET_HOME__/vtitan/src/python/.env
Environment=ROS_DOMAIN_ID=0
# Safe to run from boot even though it is the thing that moves the robot:
# track_navigator_node holds until /robot_state reports racing, so the physical
# start button remains the only way to make the robot drive. Launched with no
# metadata argument on purpose -- that is competition mode, where the layout is
# estimated from LIDAR rather than read from a scenario file.
#
# launch-race (not a raw "ros2 launch") -- the pixi task sources
# ros2_ws/install/setup.bash first, matching the other services.
ExecStart=__TARGET_HOME__/.pixi/bin/pixi run -e vision launch-race
Restart=on-failure
RestartSec=5
# SIGINT rather than SIGTERM: it propagates to bag_recorder_node, which needs a
# clean shutdown to finalize an in-flight bag's metadata.
ExecStop=/usr/bin/kill -SIGINT $MAINPID
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
