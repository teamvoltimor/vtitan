# Deployed identically to both boards by deploy/ansible/roles/common (see its "Install udev rules"
# task) -- a rule for hardware that isn't wired to a given board simply never matches, so one
# shared file is safe. Per-rule board targeting, for reference:

# GPIO — group gpio. Pi Zero: button, challenge-mode jumper. Pi 5: none currently.
SUBSYSTEM=="gpio*", KERNEL=="gpiochip*", ACTION=="add", \
    PROGRAM="/bin/sh -c 'chown root:gpio /dev/gpiochip* && chmod 660 /dev/gpiochip*'"

# PWM for servo + motor — Pi Zero only.
SUBSYSTEM=="pwm*", ACTION=="add", \
    PROGRAM="/bin/sh -c 'chown -R root:gpio /sys/class/pwm && chmod -R 770 /sys/class/pwm'"

# I2C for OLED — Pi Zero only. (I2C is also used by some IMU mount variants, which can be
# either board depending on wiring -- see src/python/config/hardware/imu/.)
SUBSYSTEM=="i2c-dev", MODE="0666"

# LiDAR serial — Pi 5 only.
KERNEL=="ttyUSB[0-9]*", MODE="0660", GROUP="dialout"
