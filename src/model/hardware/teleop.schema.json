{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vtitan.local/schemas/hardware/teleop.schema.json",
  "title": "HardwareTeleop",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "steering_axis_index": {
      "type": "integer",
      "description": "Steering axis index."
    },
    "throttle_axis_index": {
      "type": "integer",
      "description": "Throttle axis index."
    },
    "deadman_button_index": {
      "type": "integer",
      "description": "Deadman button index."
    },
    "steering_invert": {
      "type": "boolean",
      "description": "Steering invert."
    },
    "throttle_invert": {
      "type": "boolean",
      "description": "Throttle invert."
    },
    "max_steering_deg": {
      "type": "number",
      "description": "Max steering deg."
    },
    "max_speed_mps": {
      "type": "number",
      "description": "Max speed mps."
    },
    "publish_rate_hz": {
      "type": "number",
      "description": "Publish rate hz."
    },
    "joy_timeout_s": {
      "type": "number",
      "description": "Joy timeout s."
    }
  },
  "required": [
    "steering_axis_index",
    "throttle_axis_index",
    "deadman_button_index",
    "steering_invert",
    "throttle_invert",
    "max_steering_deg",
    "max_speed_mps",
    "publish_rate_hz",
    "joy_timeout_s"
  ]
}
