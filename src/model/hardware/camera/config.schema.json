{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vtitan.local/schemas/hardware/camera/config.schema.json",
  "title": "HardwareCameraConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device": {
      "type": "string",
      "description": "V4L2 camera device path (e.g. /dev/video0)."
    },
    "width": {
      "type": "integer",
      "description": "Camera capture width in pixels."
    },
    "height": {
      "type": "integer",
      "description": "Camera capture height in pixels."
    },
    "fps": {
      "type": "integer",
      "description": "Target camera capture rate in frames per second."
    },
    "rotation": {
      "type": "integer",
      "description": "Camera rotation in degrees (0, 90, 180, 270)."
    },
    "hflip": {
      "type": "boolean",
      "description": "Mirror the camera image horizontally."
    },
    "vflip": {
      "type": "boolean",
      "description": "Mirror the camera image vertically."
    }
  },
  "required": [
    "device",
    "width",
    "height",
    "fps",
    "rotation",
    "hflip",
    "vflip"
  ]
}
