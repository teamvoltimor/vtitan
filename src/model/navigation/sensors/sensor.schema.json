{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vtitan.local/schemas/navigation/sensors/sensor.schema.json",
  "title": "NavigationSensorsSensor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stale_timeout_sec": {
