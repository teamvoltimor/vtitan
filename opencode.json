{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".rsk/SKILLS.md"
  ],
  "mcp": {
    "rdk": {
      "command": [
        "rdk",
        "mcp",
        "--read-only"
      ],
      "enabled": true,
      "type": "local"
    },
    "rsk": {
      "command": [
        "rsk",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "external_directory": {
      "~/.claude/projects/*/memory/**": "allow",
      "~/AppData/Local/Temp/**": "allow"
    }
  }
}
