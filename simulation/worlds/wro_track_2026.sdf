<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="wro_track_2026">

    <!-- Physics settings -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Lighting (will be randomized by generator) -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1.0</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Additional ambient light -->
    <light name="ambient_light" type="point">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane: 3200mm x 3200mm WHITE mat (WRO Spec 13.1-13.2) -->
    <model name="ground">
      <static>true</static>
      <pose>1.5 1.5 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.2 3.2</size>
            </plane>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>  <!-- WHITE -->
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.2 3.2</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- EXTERIOR WALLS: 3000mm x 3000mm inner track, 100mm height, BLACK (WRO Spec 13.3-13.4) -->

    <!-- North wall (thickness extends outward, overlaps at corners) -->
    <model name="exterior_wall_north">
      <static>true</static>
      <pose>1.5 3.05 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>3.1 0.1 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>  <!-- BLACK -->
            <diffuse>0.0 0.0 0.0 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>3.1 0.1 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- South wall (thickness extends outward, overlaps at corners) -->
    <model name="exterior_wall_south">
      <static>true</static>
      <pose>1.5 -0.05 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>3.1 0.1 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>3.1 0.1 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- East wall (thickness extends outward, overlaps at corners) -->
    <model name="exterior_wall_east">
      <static>true</static>
      <pose>3.05 1.5 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.1 3.2 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.1 3.2 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- West wall (thickness extends outward, overlaps at corners) -->
    <model name="exterior_wall_west">
      <static>true</static>
      <pose>-0.05 1.5 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.1 3.2 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.1 3.2 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- CORNER LINES: Orange and Blue lines at 30° angles (WRO Spec 13.9) -->
    <!-- 20mm thick lines radiating from inner corners -->

    <!-- Northeast corner - Blue line (extends to wall, 420mm from corner) -->
    <model name="corner_ne_blue">
      <static>true</static>
      <pose>2.5 2.29 0.0001 0 0 0.524</pose>  <!-- 30° angle, center of line -->
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.156 0.02 0.001</size></box>  <!-- From (2.0,2.0) to (3.0,2.58) -->
          </geometry>
          <material>
            <ambient>0.0 0.2 1.0 1</ambient>  <!-- Blue CMYK(100,80,0,0) -->
            <diffuse>0.0 0.2 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Southeast corner - Orange line (extends to wall, 420mm from corner) -->
    <model name="corner_se_orange">
      <static>true</static>
      <pose>2.5 0.71 0.0001 0 0 -0.524</pose>  <!-- -30° angle, center of line -->
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.156 0.02 0.001</size></box>  <!-- From (2.0,1.0) to (3.0,0.42) -->
          </geometry>
          <material>
            <ambient>1.0 0.4 0.0 1</ambient>  <!-- Orange CMYK(0,60,100,0) -->
            <diffuse>1.0 0.4 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Southwest corner - Blue line (extends to wall, 420mm from corner) -->
    <model name="corner_sw_blue">
      <static>true</static>
      <pose>0.5 0.71 0.0001 0 0 -2.618</pose>  <!-- -150° angle, center of line -->
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.156 0.02 0.001</size></box>  <!-- From (1.0,1.0) to (0.0,0.42) -->
          </geometry>
          <material>
            <ambient>0.0 0.2 1.0 1</ambient>  <!-- Blue CMYK(100,80,0,0) -->
            <diffuse>0.0 0.2 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Northwest corner - Orange line (extends to wall, 420mm from corner) -->
    <model name="corner_nw_orange">
      <static>true</static>
      <pose>0.5 2.29 0.0001 0 0 2.618</pose>  <!-- 150° angle, center of line -->
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.156 0.02 0.001</size></box>  <!-- From (1.0,2.0) to (0.0,2.58) -->
          </geometry>
          <material>
            <ambient>1.0 0.4 0.0 1</ambient>  <!-- Orange CMYK(0,60,100,0) -->
            <diffuse>1.0 0.4 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- STARTING ZONES: 200×500mm zones with grey dashed marking (WRO Spec 13.10-13.11) -->
    <!-- Example starting zone in south section -->
    <model name="starting_zone_south">
      <static>true</static>
      <pose>1.5 0.5 0.0002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.2 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>  <!-- Grey CMYK(0,0,0,30) -->
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- TRAFFIC SIGN SEATS: 50×50mm grey squares (WRO Spec 13.12-13.13) -->
    <!-- Example sign seats - generator will add more dynamically -->

    <model name="sign_seat_example_1">
      <static>true</static>
      <pose>2.1 2.1 0.0003 0 0 0</pose>
      <link name="link">
        <!-- 50×50mm square marker -->
        <visual name="square">
          <geometry>
            <box><size>0.05 0.05 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 0.5</ambient>  <!-- Semi-transparent grey -->
            <diffuse>0.7 0.7 0.7 0.5</diffuse>
          </material>
        </visual>
        <!-- 85mm diameter evaluation circle -->
        <visual name="circle">
          <geometry>
            <cylinder>
              <radius>0.0425</radius>
              <length>0.0005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 1.0 0.0 0.3</ambient>  <!-- Semi-transparent lime green -->
            <diffuse>0.8 1.0 0.0 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central logo area (800×800mm) - Optional visual reference -->
    <model name="central_logo">
      <static>true</static>
      <pose>1.5 1.5 0.0001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 0.5</ambient>  <!-- Light grey, semi-transparent -->
            <diffuse>0.9 0.9 0.9 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- CORRIDOR DIVISION GRID LINES (Grey dashed lines at 1000mm intervals) -->
    <!-- Vertical line at X=1.0 -->
    <model name="grid_line_v1">
      <static>true</static>
      <pose>1.0 1.5 0.0001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.001 3.0 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 0.5</ambient>  <!-- Grey dashed line -->
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical line at X=2.0 -->
    <model name="grid_line_v2">
      <static>true</static>
      <pose>2.0 1.5 0.0001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.001 3.0 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 0.5</ambient>
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal line at Y=1.0 -->
    <model name="grid_line_h1">
      <static>true</static>
      <pose>1.5 1.0 0.0001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.001 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 0.5</ambient>
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal line at Y=2.0 -->
    <model name="grid_line_h2">
      <static>true</static>
      <pose>1.5 2.0 0.0001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.001 0.001</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 0.5</ambient>
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
