<?xml version="1.0"?>
<sdf version="1.7">
  <model name="traffic_pillar">
    <static>true</static>
    <link name="link">
      <!-- Cylinder pillar -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>  <!-- Default red, will be overridden -->
          <diffuse>1 0 0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
