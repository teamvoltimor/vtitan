<?xml version="1.0"?>
<sdf version="1.7">
  <model name="obstacle_block">
    <static>false</static>
    <link name="link">
      <!-- Rectangular block obstacle -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.10 0.10 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.3 0.1 1</ambient>  <!-- Brown/orange block -->
          <diffuse>0.6 0.3 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.10 0.10 0.10</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
