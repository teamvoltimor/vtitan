# Build stage – compile the Go orchestration API.
FROM golang:1.26-alpine AS builder

WORKDIR /build

# Copy manifests first so the module download layer is cached until they change.
COPY api/go.mod api/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY api/ .

# CGO_ENABLED=0: modernc.org/sqlite is a pure-Go driver — no C toolchain needed.
# Cache mounts persist the module and compiler caches across builds so a source
# change recompiles incrementally instead of from scratch.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -o /app/api ./cmd/api

# Runtime stage – minimal Alpine image with no build tools.
#
# NOT distroless: modernc.org/sqlite (the pure-Go SQLite driver used here)
# fails to open its database file under gcr.io/distroless/static-debian12
# AND gcr.io/distroless/base-debian12, both as root and as the nonroot user
# ("ping db: unable to open database file (14)") -- verified locally across
# both variants and multiple writable paths (/app, /home/nonroot) before
# reverting. Root cause not pinned down (a distroless VFS/locking gap, not
# a permissions issue, since it reproduces as root too); revisit if a fixed
# driver version resolves it upstream.
FROM alpine:3.21

RUN addgroup -g 10001 apiuser && adduser -D -u 10001 -G apiuser apiuser \
    && apk add --no-cache ca-certificates

WORKDIR /app

# Binaries go under bin/ so ./api/openapi.yaml below (read at runtime via
# DefaultOpenAPIPath = "api/openapi.yaml") doesn't collide with a file
# also named /app/api.
COPY --from=builder /app/api ./bin/api
COPY --from=builder /build/openapi.yaml ./api/openapi.yaml

RUN chown -R apiuser:apiuser /app
USER apiuser

ARG API_PORT=8000
ENV API_PORT=${API_PORT}

EXPOSE ${API_PORT}

# wget ships with Alpine's busybox, so no separate probe binary is needed.
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=10s \
    CMD wget --quiet --tries=1 --spider "http://localhost:${API_PORT}/readyz" || exit 1

CMD ["/app/bin/api"]
