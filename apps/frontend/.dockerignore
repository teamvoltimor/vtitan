# Prevents `COPY . .` in the Dockerfile from pulling secrets or host-arch
# artifacts into the build context/image.

# Secrets — never send these to the Docker daemon
.env
.env.*
!.env.example

# Dependencies (reinstalled inside the image; host node_modules is often a
# different platform/arch than the Linux build stage)
node_modules

# Build output (regenerated by `pnpm run build` inside the image)
dist

# VCS / editor / tooling
.git
.gitignore
.vscode
.claude

# Logs and local caches
*.log
.eslintcache
.vite
