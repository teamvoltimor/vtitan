# Build stage – install Python deps (devel base provides compilers for any C extensions).
# Ubuntu 24.04 ships Python 3.12 in main repos; no deadsnakes PPA needed.
FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="8.9"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv git curl

# Install uv from its official image – no pip bootstrap needed.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency manifests first so this layer is cached until they change.
COPY ml-service/pyproject.toml ml-service/uv.lock ./

# Use a BuildKit cache mount so uv's wheel cache persists across builds.
# --no-build-isolation-package sam2: sam2's build-system.requires pulls nvidia-cudnn-cu12
# (~800 MB) into an isolated env before compiling. The CUDA base image already has cuDNN
# as a system library, so we skip the isolated env and build against the current venv instead.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev --frozen --python /usr/bin/python3.12 \
        --no-build-isolation-package sam2


# Runtime stage – much smaller: no build tools, no CUDA headers.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ARG GRPC_PORT=50051

ENV DEBIAN_FRONTEND=noninteractive \
    GRPC_PORT=${GRPC_PORT} \
    HF_HUB_CACHE=/app/models \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.12 libglib2.0-0 libgl1 libxcb1 curl

WORKDIR /app

# Copy the virtual environment built in the builder stage.
# --link makes this an independent snapshot layer, avoiding the UtimesNanoAt
# crash in Docker Desktop for Windows with the containerd snapshotter.
COPY --link --from=builder /app/.venv .venv

# Copy application source (models are mounted as a volume at runtime).
COPY ml-service/grpc_main.py .
COPY ml-service/config/ config/
COPY ml-service/src/ src/

# Run as a dedicated non-root user. /app/data and /app/models are
# volume-mounted at runtime (docker-compose.yml) and must stay writable by
# this uid, since Docker preserves the host mount's ownership over any image
# layer's chown -- ensure the host-side directories are owned by 10001:10001
# (or world-writable) before first run.
RUN groupadd -g 10001 mlservice && useradd -u 10001 -g mlservice -M mlservice \
    && mkdir -p /app/data /app/models && chown -R mlservice:mlservice /app
USER mlservice

EXPOSE ${GRPC_PORT}

# grpc_main.py opens the gRPC port early (before any lazy model load), so a
# bare TCP connect is a sufficient readiness signal without depending on the
# grpc.health.v1 protocol, which this server doesn't implement.
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=30s \
    CMD python3 -c "import socket; socket.create_connection(('localhost', ${GRPC_PORT}), timeout=3)" || exit 1

# DEFAULT_MODEL is optional; skip --model flag when unset.
CMD ["sh", "-c", "python grpc_main.py ${DEFAULT_MODEL:+--model $DEFAULT_MODEL}"]
