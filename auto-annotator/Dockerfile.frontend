# Build stage — compile the React/Vite app into static assets.
FROM node:22-alpine AS builder

WORKDIR /app

# Setting VITE_API_BASE_URL to "" tells the client to use relative URLs
# (e.g. /gallery, /segment) so nginx can proxy them to the backend.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend/ .
RUN npm run build


# Serve stage — serve static assets and proxy API calls via nginx.
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
