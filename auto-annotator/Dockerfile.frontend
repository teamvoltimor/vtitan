# Build stage – compile the frontend with Vite.
FROM node:22-alpine AS builder

WORKDIR /build

# Install pnpm via corepack (included with Node 16+).
RUN corepack enable

# Copy manifests first so the dependency layer is cached until they change.
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Install dependencies with pnpm (frozen-lockfile ensures reproducible builds).
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile

COPY frontend/ .

# Build the frontend for production.
RUN pnpm build


# Runtime stage – serve the built frontend with nginx.
FROM nginx:1.27-alpine

WORKDIR /etc/nginx/conf.d

# SPA routing: send all non-file requests to index.html.
RUN cat > default.conf <<'NGINX_EOF'
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Cache static assets with long TTL.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA routing: send all non-file requests to index.html.
    location / {
        try_files $uri /index.html;
    }
}
NGINX_EOF

# Copy built frontend from builder stage.
COPY --from=builder /build/dist /usr/share/nginx/html

ARG FRONTEND_PORT=80
EXPOSE ${FRONTEND_PORT}

CMD ["nginx", "-g", "daemon off;"]
