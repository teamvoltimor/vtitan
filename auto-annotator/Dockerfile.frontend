# Build stage – compile the frontend with Vite.
FROM node:22-alpine AS builder

WORKDIR /build

# Install pnpm via corepack (included with Node 16+).
RUN corepack enable

# Copy manifests first so the dependency layer is cached until they change.
# pnpm-workspace.yaml must be included here too: it holds the allowBuilds
# approval for esbuild's postinstall script, which `pnpm install` checks
# immediately -- without it present at install time, pnpm refuses to run
# that script and the install fails.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./

# Install dependencies with pnpm (frozen-lockfile ensures reproducible builds).
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile

COPY frontend/ .

# Build the frontend for production.
RUN pnpm build


# Runtime stage – serve the built frontend with nginx.
FROM nginx:1.27-alpine

# Use the repo's real nginx config (frontend/nginx.conf), which proxies
# /api/v1|healthz|readyz to the Go API service -- an inline config here
# previously silently dropped that reverse-proxy block, breaking
# frontend->API calls in the containerized stack.
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend from builder stage.
COPY --from=builder /build/dist /usr/share/nginx/html

ARG FRONTEND_PORT=80
EXPOSE ${FRONTEND_PORT}

CMD ["nginx", "-g", "daemon off;"]
