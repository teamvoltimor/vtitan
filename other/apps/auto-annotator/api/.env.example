# Go API service configuration (Viper reads this .env plus real env vars).
# Copy to .env and adjust. During parallel development the Go API points at the
# existing Python backend's data directory and SQLite manifest.

API_PORT=8000
API_PUBLIC_URL=http://localhost:8000

# Paths (point at the Python backend while both stacks run side by side).
DB_PATH=../backend/data/manifest.db
DATA_DIR=../backend/data
MODELS_CONFIG=../backend/config/models.toml

# Allowed CORS origins (comma-separated) — the Vite dev server and any extras.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Python compute-worker gRPC addresses (used in later phases; leave blank for now).
SEGMENT_GRPC_ADDR=
AUGMENT_GRPC_ADDR=
TRAIN_GRPC_ADDR=
