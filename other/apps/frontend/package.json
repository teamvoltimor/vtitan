{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint",
    "format": "biome format",
    "preview": "vite preview",
    "api:generate": "pnpm run api:generate:telemetry && pnpm run api:generate:robot",
    "api:generate:telemetry": "openapi-ts -i ../../contracts/openapi/contexts/telemetry.yaml -o ./src/api/generated -p @hey-api/typescript",
    "api:generate:robot": "openapi-ts -i ../../contracts/openapi/contexts/robot.yaml -o ./src/api/generated/robot -p @hey-api/typescript",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.183.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@hey-api/openapi-ts": "^0.98.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.14.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
