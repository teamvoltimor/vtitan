# Voldemorbot Backend (Go telemetry server) — Environment Configuration
#
# These map to the Viper config in internal/config/config.go (env prefix
# "TELEMETRY_", AutomaticEnv). The server reads them from the process
# environment — it does NOT auto-load a .env file — so export them in your
# shell or set them under `environment:` in docker-compose. This file documents
# the full set with their defaults.

# HTTP server listen address (REST + WebSocket).
TELEMETRY_HTTP_ADDR=:8010

# gRPC server listen address (robot telemetry feed).
TELEMETRY_GRPC_ADDR=:9010

# In-memory telemetry ring-buffer size (samples retained per session).
TELEMETRY_HISTORY_SIZE=360

# Developer mode (verbose behavior; enabled by `backend:dev` task).
TELEMETRY_DEV=false

# Synthetic generator tick interval in ms (used with the -sim flag).
TELEMETRY_SIM_INTERVAL_MS=2500

# Maximum number of concurrent recorded sessions.
TELEMETRY_MAX_SESSIONS=20

# Directory for persisted session recordings.
TELEMETRY_SESSIONS_DIR=data/sessions

# SQLite database path for session metadata.
TELEMETRY_DB_PATH=data/sessions.db
