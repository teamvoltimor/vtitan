# Voldemorbot Frontend (Vite + React) — Environment Configuration
# Copy to `.env` (or `.env.local`) and adjust. Only VITE_-prefixed vars are
# exposed to the client bundle.

# Base URL of the Go telemetry backend (REST + WebSocket origin).
VITE_TELEMETRY_BASE=http://localhost:8010

# Telemetry poll interval in milliseconds.
VITE_POLL_INTERVAL_MS=2500

# Demo Mode — set to "true" to run with mock telemetry and no backend.
# (Equivalent to the `frontend:dev:demo` task or appending ?demo to the URL.)
VITE_DEMO=false
