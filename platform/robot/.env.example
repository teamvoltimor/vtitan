# vTitan Robot — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
#
# Most hardware driver defaults now live in config/hardware/**/*.toml (see
# src/hardware/settings_base.py) instead of here. An env var of the same name
# still overrides its TOML value, so this file only needs to carry:
#   - fields with NO TOML default (device ports / GPIO pins with no known
#     real value checked in -- the corresponding driver will fail to start
#     if these are unset)
#   - values read directly by launch files or nodes outside the TOML system
#   - genuine runtime/ops knobs unrelated to any hardware driver

# Button configuration
# MCP2221A button driver's GPIO channel (0-3, i.e. GP0-GP3) -- no known real
# value checked into config/hardware/button/mcp2221.toml. REQUIRED if that
# driver variant is in use. See config/hardware/button/*.toml for every other
# button/MCP2221 default (pull-up, debounce, long-press threshold, USB IDs).
MCP2221_BUTTON_GPIO_PIN=

# Challenge-mode jumper: see config/hardware/challenge_mode.toml for the
# default GPIO pin and wiring notes (matters on the Pi Zero's .env, not Pi 5's).

# OLED display: see config/hardware/display/*.toml for SSD1306 dimensions/I2C
# address/bus and the node's refresh rate / backend selection.

# IMU configuration (BNO08x)
# Serial port for UART connection (plain or MCP2221 bridge -- both variants
# share this env var). Leave empty for auto-detection based on VID/PID.
# Manual override: /dev/ttyACM0 or /dev/ttyACM1
BNO08X_UART_RVC_PORT=""

# See config/hardware/imu/*.toml for baud rate, poll rate, quaternion/Euler
# orientation handling, and MCP2221 USB IDs for every BNO08x variant.

# Motor backend selection
# Steering and drive are chosen independently. Build HAT classes are preserved
# and can be re-selected for either side.
#   STEERING_BACKEND: servo | build_hat
#   DRIVE_BACKEND:    dc_encoder | build_hat
STEERING_BACKEND=servo
DRIVE_BACKEND=dc_encoder

# Motor configuration
# Port for steering motor (serial port, I2C address, etc.) — REQUIRED,
# hardware-specific, no TOML default. Config uses env_nested_delimiter="__"
# (double underscore) so nested leaf names containing underscores parse
# correctly -- MOTOR_STEERING__PORT, not MOTOR_STEERING_PORT.
MOTOR_STEERING__PORT=""

# Port for drive motor (serial port, I2C address, etc.) — REQUIRED,
# hardware-specific, no TOML default.
MOTOR_DRIVE__PORT=""

# Duration in seconds for motor test/diagnostic routines. REQUIRED, no
# Python default (see ackermann_motor_node.py's on_configure) despite
# config/hardware/motors/motors.toml also defining test_duration -- that
# TOML value is not actually wired into this env-only field, so omitting
# this line is a silent Config() ValidationError caught nowhere in the
# call chain: on_configure() raises before its own try/except block, the
# ROS2 lifecycle framework swallows it without a traceback, and the node
# gets stuck permanently unconfigured -- confirmed live on hardware
# 2026-08-09 (motors never activated after a fresh .env restore had this
# line missing, easy to misdiagnose as a wiring/pin problem since nothing
# in the log actually says why). Keep in sync with motors.toml's value.
MOTOR_TEST_DURATION=1.5

# See config/hardware/motors/motors.toml for steering/drive tuning (offsets,
# limits, speed scale, reversal flags) and config/hardware/motors/servo.toml
# for the servo backend's pulse widths and range.

# Drive - DC encoder + L298N backend (used when DRIVE_BACKEND=dc_encoder)
# Not yet migrated to TOML -- read directly by ackermann_motor_node.
# L298N: IN3/IN4 set direction, ENB is the PWM (speed) pin, no STBY line.
# BCM pin for the L298N ENB (PWM speed) input
MOTOR_PWM_PIN=13
# BCM pins for the L298N IN3 / IN4 (direction) inputs
MOTOR_IN3_PIN=5
MOTOR_IN4_PIN=6
# BCM pins for the quadrature encoder channels A / B
MOTOR_ENCODER_A_PIN=16
MOTOR_ENCODER_B_PIN=20

# Camera configuration
# See config/hardware/camera/*.toml for capture resolution/fps, rotation,
# mirroring, and read timeout across every camera driver variant.

# Debug video. The vision node opens the camera itself and feeds frames
# straight to the NPU, so by default a run publishes /vision/detections and no
# imagery at all. Set to 1 to also publish /camera/image_raw and
# /vision/image_annotated (boxes and labels drawn) for testing -- about 4 MB
# per frame between them at 1536x864, so leave it 0 for a competition run.
# Read directly by rpi5_nodes.launch.py (os.environ), not through TOML.
# View with `rqt_image_view /vision/image_annotated`, or record with
# `python scripts/hardware/record_vision_video.py --seconds 20 --out /tmp/run.mp4`.
VISION_DEBUG_VIDEO=0

# Hailo AI configuration
# Path to Hailo .hef neural network model file. Must be a compiled HEF model
# compatible with Hailo-8. The traffic-sign model is the 3-class GMR detector
# built by `task gmr:workflow` in hailo/ and deployed by
# scripts/deploy-to-pi5.sh.
#
# This value OVERRIDES the code default, because src/logger/config.py calls
# load_dotenv() at import. A path that does not exist surfaces only as
# HailoRT error 13 (HAILO_OPEN_FILE_FAILURE) when the model loads.
# Read directly by rpi5_nodes.launch.py (os.environ) to pass to the vision
# node's launch-time parameters, in addition to config/hardware/hailo.toml's
# own default for the Hailo Config class used elsewhere.
HAILO_MODEL_PATH=/usr/local/hailo/models/gmr.hef

# See config/hardware/hailo.toml for the data.yaml path, minimum confidence,
# inference timeout, and benchmark iteration count.

# See config/hardware/vision/*.toml for the vision node's default topics,
# backend, camera source, and the detector's minimum confidence.

# State machine timing
# Sensor timeout in seconds
# How long to wait for sensor data before marking as unavailable
# Default: 3.0 seconds
SENSOR_TIMEOUT_SEC=3.0

# IP address fetch timeout in seconds
# Non-blocking network query timeout
# Default: 2.0 seconds
IP_FETCH_TIMEOUT_SEC=2.0

# Race configuration
# Number of laps required to complete race
# WRO standard: 3 laps
TARGET_LAPS=3

# ROS2 configuration
# ROS2 domain ID (for multi-robot environments)
# Default: 0 (same as ROS_DOMAIN_ID)
# ROS_DOMAIN_ID=0
# Use simulation time (set true under Gazebo).
# USE_SIM_TIME=false

# Logging configuration
# Log level for state machine node
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable JSON structured logging
# JSON_LOGGING=true

# GPIO permissions (Linux)
# If you get GPIO permission errors, run:
# sudo usermod -a -G gpio $USER
# sudo usermod -a -G i2c $USER
# Then log out and back in

# I2C permissions (Linux)
# If you get I2C permission errors, run:
# sudo chmod a+rw /dev/i2c-*
# Or add persistent udev rule:
# sudo sh -c 'echo "SUBSYSTEM==\"i2c-dev\", MODE=\"0666\"" > /etc/udev/rules.d/99-i2c.rules'
# sudo udevadm control --reload-rules && sudo udevadm trigger
