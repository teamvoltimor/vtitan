# WRO State Machine Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================================
# BUTTON CONFIGURATION
# ============================================================
# GPIO pin number for the physical push-button
# Default: GPIO17 (Physical Pin 11 on Raspberry Pi)
BUTTON_GPIO_PIN=17

# Use internal pull-up resistor
# Set to True if button connects GPIO to GND
# Set to False if using external pull-down resistor
BUTTON_PULL_UP=True

# Debounce delay in milliseconds
# Filters out electrical noise from button presses
# Range: 20-100ms typical
BUTTON_DEBOUNCE_MS=50

# Long press threshold in seconds for Emergency Stop
# WRO rules: 2-second hold triggers E-STOP
BUTTON_LONG_PRESS_SEC=2.0

# ============================================================
# OLED DISPLAY CONFIGURATION
# ============================================================
# Display dimensions (SSD1306 standard sizes)
# Common: 128x64 or 128x32
DISPLAY_WIDTH=128
DISPLAY_HEIGHT=64

# I2C address of the SSD1306 display
# Common addresses: 0x3C or 0x3D
# Use i2cdetect -y 1 to verify
DISPLAY_I2C_ADDRESS=0x3C

# I2C bus number
# Raspberry Pi typically uses bus 1 (/dev/i2c-1)
DISPLAY_I2C_BUS=1

# ============================================================
# IMU CONFIGURATION (BNO08x via MCP2221A)
# ============================================================
# Serial port for MCP2221 UART connection
# Leave empty for auto-detection based on VID/PID
# Manual override: /dev/ttyACM0 or /dev/ttyACM1
IMU_UART_RVC_PORT=

# Baud rate for UART communication
# BNO08x RVC mode uses 115200 baud
IMU_UART_RVC_BAUDRATE=115200

# IMU polling rate in Hz
# Higher rates increase CPU usage
# Recommended: 50-100 Hz
IMU_UART_RVC_POLL_RATE=100

# MCP2221 USB Vendor ID (VID)
# Default: 0x04D8 (Microchip Technology Inc.)
IMU_UART_RVC_MCP2221_VID=0x04D8

# MCP2221 USB Product ID (PID)
# Default: 0x00DD (MCP2221)
IMU_UART_RVC_MCP2221_PID=0x00DD

# ============================================================
# MOTOR CONFIGURATION (Build HAT - Pi Zero)
# ============================================================
# Build HAT port assignments
# Ports: A, B, C, D
MOTOR_STEERING_PORT=A
MOTOR_DRIVE_PORT=B

# Steering center angle offset in degrees
# Positive values bias steering to the right
# Negative values bias steering to the left
# Use this to compensate for mechanical misalignment
# Range: -10.0 to +10.0 typical
MOTOR_STEERING_OFFSET=0.0

# Reverse drive motor direction
# Set to True if motor is mounted backwards
# This flips forward/reverse commands
MOTOR_REVERSE_DRIVE=False

# Maximum drive motor speed (0-100)
# Limits top speed for safety and battery life
# WRO recommendation: 40-60 for practice, 70-80 for competition
MOTOR_MAX_SPEED=50

# Maximum steering angle in degrees
# Prevents mechanical damage from over-steering
# Typical range: 30-45 degrees
MOTOR_MAX_STEERING_ANGLE=45.0

# Velocity to motor speed scale factor
# Converts Ackermann velocity (m/s) to motor percentage (0-100)
# Formula: motor_speed = velocity * MOTOR_SPEED_SCALE
# Tune this based on wheel diameter and gear ratio
# Example: velocity 1.0 m/s → motor_speed 30 (with default scale)
MOTOR_SPEED_SCALE=30.0

# Default motor speed for testing
# Used when no speed is specified in manual control
MOTOR_DEFAULT_SPEED=15

# Motor test duration in seconds
# Used in calibration and diagnostic scripts
MOTOR_TEST_DURATION=1.5

# ============================================================
# HAILO AI CONFIGURATION
# ============================================================
# Path to Hailo .hef neural network model file
# Must be a compiled HEF model compatible with Hailo-8
HAILO_MODEL_PATH=/home/pi/models/yolov8n.hef

# ============================================================
# STATE MACHINE TIMING
# ============================================================
# UI refresh rate in Hz (how fast data updates)
# Affects OLED display number updates
# Default: 10 Hz (0.1 second intervals)
UI_REFRESH_RATE_HZ=10.0

# Page cycle interval in seconds (RACING state only)
# How long each display page shows before cycling
# Default: 1.2 seconds for readable transitions
PAGE_CYCLE_INTERVAL_SEC=1.2

# Sensor timeout in seconds
# How long to wait for sensor data before marking as unavailable
# Default: 3.0 seconds
SENSOR_TIMEOUT_SEC=3.0

# IP address fetch timeout in seconds
# Non-blocking network query timeout
# Default: 2.0 seconds
IP_FETCH_TIMEOUT_SEC=2.0

# ============================================================
# RACE CONFIGURATION
# ============================================================
# Number of laps required to complete race
# WRO standard: 3 laps
TARGET_LAPS=3

# ============================================================
# ROS2 CONFIGURATION
# ============================================================
# ROS2 domain ID (for multi-robot environments)
# Default: 0 (same as ROS_DOMAIN_ID)
# ROS_DOMAIN_ID=0

# Use simulation time
# Set to true when running with Gazebo or other simulators
# USE_SIM_TIME=false

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# Log level for state machine node
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable JSON structured logging
# JSON_LOGGING=true

# ============================================================
# GPIO PERMISSIONS (Linux)
# ============================================================
# If you get GPIO permission errors, run:
# sudo usermod -a -G gpio $USER
# sudo usermod -a -G i2c $USER
# Then log out and back in

# ============================================================
# I2C PERMISSIONS (Linux)
# ============================================================
# If you get I2C permission errors, run:
# sudo chmod a+rw /dev/i2c-*
# Or add persistent udev rule:
# sudo sh -c 'echo "SUBSYSTEM==\"i2c-dev\", MODE=\"0666\"" > /etc/udev/rules.d/99-i2c.rules'
# sudo udevadm control --reload-rules && sudo udevadm trigger
