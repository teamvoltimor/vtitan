# Voldemorbot Robot — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
#
# Each variable below maps to a pydantic-settings field (or an EnvVar). The
# variable name is `<env_prefix><FIELD>` (uppercased). Fields with NO default
# are REQUIRED — the corresponding driver/node will fail to start if they are
# unset, so keep them defined here.

# ============================================================
# BUTTON CONFIGURATION  (src/hardware/button/mcp2221/config.py, env_prefix="")
# ============================================================
# Use internal pull-up resistor.
# True if the button connects GPIO to GND; False for an external pull-down.
BUTTON__PULL_UP=True

# Debounce delay in milliseconds — filters electrical noise (20-100ms typical).
BUTTON__DEBOUNCE_MS=50

# Long-press threshold in seconds for Emergency Stop (WRO: 2s hold → E-STOP).
BUTTON__LONG_PRESS_THRESHOLD_SEC=2.0

# MCP2221A USB IDs (used to locate the button's I2C/GPIO bridge).
# Defaults: Microchip VID 0x04D8, MCP2221 PID 0x00DD.
MCP2221__VID=0x04D8
MCP2221__PID=0x00DD

# ============================================================
# OLED DISPLAY CONFIGURATION  (src/hardware/display/ssd1306/config.py, env_prefix="SSD1306_")
# ============================================================
# Display dimensions (SSD1306 standard sizes — 128x64 or 128x32).
SSD1306_WIDTH=128
SSD1306_HEIGHT=64

# I2C address of the SSD1306 display (0x3C or 0x3D — verify with `i2cdetect -y 1`).
SSD1306_I2C_ADDRESS=0x3C

# I2C bus number (Raspberry Pi typically uses bus 1 → /dev/i2c-1).
SSD1306_I2C_BUS=1

# ============================================================
# IMU — BNO08x via MCP2221A, UART RVC mode
# (src/hardware/imu/bno08x/mcp2221/uart_rvc.py, env_prefix="BNO08X_UART_RVC_")
# ============================================================
# Serial port for the MCP2221 UART connection.
# Leave empty for auto-detection by VID/PID, or set e.g. /dev/ttyACM0.
BNO08X_UART_RVC_PORT=""

# Baud rate (BNO08x RVC mode uses 115200).
BNO08X_UART_RVC_BAUDRATE=115200

# Polling rate in Hz (50-100 recommended; higher = more CPU).
BNO08X_UART_RVC_POLL_RATE_HZ=100

# Quaternion / Euler orientation handling (mount-dependent sign conventions).
# Euler sequence: one of xyz, zyx, xzy, yzx, zxy, yxz.
# Note the "__" before the nested quaternion/mcp2221 fields.
BNO08X_UART_RVC_QUATERNION__EULER_SEQUENCE="xyz"
BNO08X_UART_RVC_QUATERNION__NEGATE_YAW="true"
BNO08X_UART_RVC_QUATERNION__NEGATE_PITCH="false"
BNO08X_UART_RVC_QUATERNION__NEGATE_ROLL="true"

# MCP2221 USB IDs for the IMU's UART bridge.
BNO08X_UART_RVC_MCP2221__VID=0x04D8
BNO08X_UART_RVC_MCP2221__PID=0x00DD

# ============================================================
# IMU — BNO08x via I2C  (src/hardware/imu/bno08x/i2c.py, env_prefix="BNO08X_I2C_")
# ============================================================
# I2C address (0x4A or 0x4B depending on the ADR pin). REQUIRED.
BNO08X_I2C_ADDRESS=0x4A

# Delay (seconds) after enabling sensors to let them stabilize.
BNO08X_I2C_ENABLE_SENSORS_DELAY=0.5

# Quaternion / Euler orientation handling (same meaning as the RVC block).
BNO08X_I2C_QUATERNION__EULER_SEQUENCE="xyz"
BNO08X_I2C_QUATERNION__NEGATE_YAW="true"
BNO08X_I2C_QUATERNION__NEGATE_PITCH="false"
BNO08X_I2C_QUATERNION__NEGATE_ROLL="true"

# ============================================================
# MOTOR CONFIGURATION — Build HAT  (src/hardware/motors/config.py, env_prefix="MOTOR_")
# ============================================================
# NOTE: steering.* and drive.* are nested config models, so their env vars use
# the "__" delimiter (e.g. MOTOR_STEERING__PORT -> steering.port). The two flat
# values (MOTOR_TEST_DURATION, MOTOR_STEERING_OFFSET) use a single underscore.

# Build HAT port assignments (A, B, C, D). REQUIRED.
MOTOR_STEERING__PORT=A
MOTOR_DRIVE__PORT=B

# Steering geometry in degrees. REQUIRED (left/right limits and center).
MOTOR_STEERING__LEFT_LIMIT_ANGLE=-83.0
MOTOR_STEERING__CENTER_ANGLE=-30.0
MOTOR_STEERING__RIGHT_LIMIT_ANGLE=22.0

# Steering motion speeds.
MOTOR_STEERING__CENTERING_SPEED=20
MOTOR_STEERING__TURNING_SPEED=30

# Reverse the steering motor direction if mounted inverted.
MOTOR_STEERING__REVERSED="false"

# Reverse the drive motor direction if mounted backwards.
MOTOR_DRIVE__REVERSED="false"

# Drive speed limits. REQUIRED (min is the reverse cap, max the forward cap).
MOTOR_DRIVE__MIN_SPEED=-100
MOTOR_DRIVE__MAX_SPEED=100

# Velocity → motor-speed scale: motor_speed = velocity_m_s * scale.
MOTOR_DRIVE__SPEED_SCALE=30.0

# Default drive speed used for manual control / diagnostics. REQUIRED.
MOTOR_DRIVE__DEFAULT_SPEED=15

# Motor test/diagnostic run duration in seconds. REQUIRED (flat, top-level field).
MOTOR_TEST_DURATION=1.5

# Extra software steering trim (degrees), applied on top of CENTER_ANGLE.
# Standalone EnvVar read by the Ackermann motor node (single underscore).
# Positive biases right, negative biases left (-10.0 to +10.0 typical).
MOTOR_STEERING_OFFSET=0.0

# ============================================================
# CAMERA CONFIGURATION  (src/hardware/camera/config.py, env_prefix="CAMERA_")
# ============================================================
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=640
CAMERA_FPS=30
# Rotation in degrees (0/90/180/270) and optional flips.
CAMERA_ROTATION=0
CAMERA_HFLIP=False
CAMERA_VFLIP=False

# ============================================================
# HAILO AI CONFIGURATION  (src/hardware/hailo/config.py, env_prefix="HAILO_")
# ============================================================
# Compiled HEF model + dataset YAML compatible with Hailo-8.
HAILO_MODEL_PATH=/usr/local/hailo/models/yolo11n.hef
HAILO_DATA_YAML_PATH=/usr/local/hailo/models/data.yaml
# Detection confidence threshold (0.0-1.0) and benchmark iteration count.
HAILO_MIN_CONFIDENCE=0.45
HAILO_BENCHMARK_ITERATIONS=10

# --- Hailo streaming pipeline (src/hardware/hailo/config.py StreamingConfig,
#     env_prefix="HAILO_STREAM_"). Inherits the CAMERA_* fields under this prefix. ---
HAILO_STREAM_DEVICE=/dev/video0
HAILO_STREAM_WIDTH=640
HAILO_STREAM_HEIGHT=640
HAILO_STREAM_FPS=30
HAILO_STREAM_ROTATION=0
HAILO_STREAM_HFLIP=False
HAILO_STREAM_VFLIP=False
HAILO_STREAM_MODEL_INPUT_WIDTH=640
HAILO_STREAM_MODEL_INPUT_HEIGHT=640
HAILO_STREAM_QUEUE_SIZE=1
HAILO_STREAM_ASYNC_INFERENCE=False
# NOTE: StreamingConfig.conf_threshold uses validation_alias "min_confidence",
# so it is read from the un-prefixed MIN_CONFIDENCE var (not HAILO_STREAM_CONF_THRESHOLD).
MIN_CONFIDENCE=0.45

# ============================================================
# LOGGING  (src/logger/config.py, via EnvVar)
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Competition mode — tightens logging/behavior for race runs.
COMPETITION_MODE=False

# ============================================================
# ROS2 (standard ROS env vars — read by rclpy, not this project's config)
# ============================================================
# ROS2 domain ID for multi-robot isolation (default 0).
# ROS_DOMAIN_ID=0
# Use simulation time (set true under Gazebo).
# USE_SIM_TIME=false

# ============================================================
# GPIO / I2C PERMISSIONS (Linux)
# ============================================================
# GPIO permission errors:
#   sudo usermod -a -G gpio,i2c $USER   # then log out/in
# I2C permission errors:
#   sudo chmod a+rw /dev/i2c-*
#   # or a persistent udev rule:
#   sudo sh -c 'echo "SUBSYSTEM==\"i2c-dev\", MODE=\"0666\"" > /etc/udev/rules.d/99-i2c.rules'
#   sudo udevadm control --reload-rules && sudo udevadm trigger
