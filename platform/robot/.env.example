# Voldemorbot Robot — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
#
# Each variable below maps to a pydantic-settings field. The variable name is
# `<env_prefix><FIELD>` (uppercased). Fields with NO default
# are REQUIRED — the corresponding driver/node will fail to start if they are
# unset, so keep them defined here.

# Button configuration
# GPIO pin number for the physical push-button
# GPIO4 (Physical Pin 7 on Raspberry Pi) -- confirmed against actual wiring during
# sensor verification; GPIO17 (physical pin 11) silently connects with no error but
# never sees any edge transitions since nothing is attached to it.
BUTTON_GPIO_PIN=4

# Whether to use the internal pull-up resistor (button wired GND-to-pin,
# press = pulls LOW). REQUIRED, no default.
BUTTON__PULL_UP=true

# Debounce delay in milliseconds — filters electrical noise (20-100ms typical).
BUTTON__DEBOUNCE_MS=50

# Long-press threshold in seconds for Emergency Stop (WRO: 2s hold → E-STOP).
BUTTON__LONG_PRESS_THRESHOLD_SEC=2.0

# MCP2221A USB IDs (used to locate the button's I2C/GPIO bridge).
# Defaults: Microchip VID 0x04D8, MCP2221 PID 0x00DD.
MCP2221__VID=0x04D8
MCP2221__PID=0x00DD

# OLED display configuration
# Display dimensions (SSD1306 standard sizes)
# Common: 128x64 or 128x32
# NOTE: was previously documented as DISPLAY_WIDTH/DISPLAY_HEIGHT, which the code never
# read -- Config's env_prefix is "SSD1306_", so these must match that prefix to take effect.
SSD1306_WIDTH=128
SSD1306_HEIGHT=64

# I2C address of the SSD1306 display (0x3C or 0x3D — verify with `i2cdetect -y 1`).
SSD1306_I2C_ADDRESS=0x3C

# I2C bus number (Raspberry Pi typically uses bus 1 → /dev/i2c-1).
SSD1306_I2C_BUS=1

# SSD1306 I2C backend: blinka (Adafruit CircuitPython, default) or raw_i2c (direct
# /dev/i2c-N ioctl, no Blinka/smbus2 dependency -- written after a reproducible I2C bus
# hang was isolated to Blinka's busio.I2C + adafruit_ssd1306; smbus2-based stress tests
# showed the hardware, wiring, and kernel driver are completely reliable, and smbus2
# itself was later dropped after it destabilized `pixi install` on the Pi Zero 2W).
# Try raw_i2c if the display hangs.
DISPLAY_BACKEND=blinka

# LIDAR configuration (Slamtec C1)
# Yaw offset (degrees) applied to the base_link -> lidar_link static TF.
# Default 180 accounts for the C1 being mounted inverted -- its raw angle-zero
# points opposite robot-front. Confirmed empirically: the sector with the
# largest ranges (open space, robot-front) lands at +-180 deg in raw /scan data.
LIDAR_YAW_OFFSET_DEG=180

# IMU configuration (BNO08x via MCP2221A)
# Serial port for MCP2221 UART connection
# Leave empty for auto-detection based on VID/PID
# Manual override: /dev/ttyACM0 or /dev/ttyACM1
BNO08X_UART_RVC_PORT=""

# Baud rate (BNO08x RVC mode uses 115200).
BNO08X_UART_RVC_BAUDRATE=115200

# Polling rate in Hz (50-100 recommended; higher = more CPU).
BNO08X_UART_RVC_POLL_RATE_HZ=100

# Quaternion / Euler orientation handling (mount-dependent sign conventions).
# Euler sequence: one of xyz, zyx, xzy, yzx, zxy, yxz.
# Note the "__" before the nested quaternion/mcp2221 fields.
BNO08X_UART_RVC_QUATERNION__EULER_SEQUENCE="xyz"
BNO08X_UART_RVC_QUATERNION__NEGATE_YAW="true"
BNO08X_UART_RVC_QUATERNION__NEGATE_PITCH="false"
BNO08X_UART_RVC_QUATERNION__NEGATE_ROLL="true"

# MCP2221 USB IDs for the IMU's UART bridge.
BNO08X_UART_RVC_MCP2221__VID=0x04D8
BNO08X_UART_RVC_MCP2221__PID=0x00DD

# Motor backend selection
# Steering and drive are chosen independently. Build HAT classes are preserved
# and can be re-selected for either side.
#   STEERING_BACKEND: servo | build_hat
#   DRIVE_BACKEND:    dc_encoder | build_hat
STEERING_BACKEND=servo
DRIVE_BACKEND=dc_encoder

# Motor configuration - Build HAT (used only when *_BACKEND=build_hat)

# Delay (seconds) after enabling sensors to let them stabilize.
BNO08X_I2C_ENABLE_SENSORS_DELAY=0.5

# Steering center angle offset in degrees
# Positive values bias steering to the right
# Negative values bias steering to the left
# Use this to compensate for mechanical misalignment
# Range: -10.0 to +10.0 typical
#
# Config uses env_nested_delimiter="__" (double underscore) so nested leaf
# names containing underscores parse correctly -- MOTOR_STEERING__PORT, not
# MOTOR_STEERING_PORT.
# Port for steering motor (serial port, I2C address, etc.) — REQUIRED, hardware-specific.
MOTOR_STEERING__PORT=""
MOTOR_STEERING__OFFSET=0.0
MOTOR_STEERING__LEFT_LIMIT_ANGLE=-83.0
MOTOR_STEERING__CENTER_ANGLE=-30.0
MOTOR_STEERING__RIGHT_LIMIT_ANGLE=22.0
MOTOR_STEERING__MAX_STEERING_ANGLE=45.0
MOTOR_STEERING__CENTERING_SPEED=20
MOTOR_STEERING__TURNING_SPEED=30
MOTOR_STEERING__REVERSED=false

# Drive motor configuration
# Port for drive motor (serial port, I2C address, etc.) — REQUIRED, hardware-specific.
MOTOR_DRIVE__PORT=""
# true on the real robot: the drive motor's leads are wired to the L298N such
# that a positive motor_speed spins it backwards. Verified 2026-07-25 on
# hardware -- with this false, commanding forward drives the robot in reverse
# (see docs/sensor-verification.md's drive-motor characterisation section).
MOTOR_DRIVE__REVERSED=true
MOTOR_DRIVE__MIN_SPEED=-100
MOTOR_DRIVE__MAX_SPEED=100

# Velocity → motor-speed scale: motor_speed = velocity_m_s * scale.
MOTOR_DRIVE__SPEED_SCALE=30.0

# Default drive speed used for manual control / diagnostics. REQUIRED.
MOTOR_DRIVE__DEFAULT_SPEED=15

# Motor test/diagnostic run duration in seconds. REQUIRED (flat, top-level field).
MOTOR_TEST_DURATION=1.5

# Steering - servo backend (used when STEERING_BACKEND=servo)
# Single servo, parallel/crab steering. Read by ServoConfig (SERVO_ prefix).
# BCM pin driving the servo signal (Pi Zero physical 32 / PWM1)
SERVO_GPIO_PIN=12
# Pulse width (us) at full-left and full-right travel
SERVO_MIN_PULSE_US=500
SERVO_MAX_PULSE_US=2500
# Total mechanical travel (deg) spanned between min and max pulse
SERVO_RANGE_DEG=180
# Pulse width (us) for wheels-straight
SERVO_CENTER_PULSE_US=1500
# Invert direction if the servo is mounted so left commands turn right
SERVO_REVERSED=false

# Drive - DC encoder + L298N backend (used when DRIVE_BACKEND=dc_encoder)
# L298N: IN3/IN4 set direction, ENB is the PWM (speed) pin, no STBY line.
# BCM pin for the L298N ENB (PWM speed) input
MOTOR_PWM_PIN=13
# BCM pins for the L298N IN3 / IN4 (direction) inputs
MOTOR_IN3_PIN=5
MOTOR_IN4_PIN=6
# BCM pins for the quadrature encoder channels A / B
MOTOR_ENCODER_A_PIN=16
MOTOR_ENCODER_B_PIN=20

# Hailo AI configuration
# Path to Hailo .hef neural network model file
# Must be a compiled HEF model compatible with Hailo-8
HAILO_MODEL_PATH=/home/pi/models/yolov8n.hef

# State machine timing
# UI refresh rate in Hz (how fast data updates)
# Affects OLED display number updates
# Default: 10 Hz (0.1 second intervals)
UI_REFRESH_RATE_HZ=10.0

# Page cycle interval in seconds (RACING state only)
# How long each display page shows before cycling
# Default: 1.2 seconds for readable transitions
PAGE_CYCLE_INTERVAL_SEC=1.2

# Sensor timeout in seconds
# How long to wait for sensor data before marking as unavailable
# Default: 3.0 seconds
SENSOR_TIMEOUT_SEC=3.0

# IP address fetch timeout in seconds
# Non-blocking network query timeout
# Default: 2.0 seconds
IP_FETCH_TIMEOUT_SEC=2.0

# Race configuration
# Number of laps required to complete race
# WRO standard: 3 laps
TARGET_LAPS=3

# ROS2 configuration
# ROS2 domain ID (for multi-robot environments)
# Default: 0 (same as ROS_DOMAIN_ID)
# ROS_DOMAIN_ID=0
# Use simulation time (set true under Gazebo).
# USE_SIM_TIME=false

# Logging configuration
# Log level for state machine node
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable JSON structured logging
# JSON_LOGGING=true

# GPIO permissions (Linux)
# If you get GPIO permission errors, run:
# sudo usermod -a -G gpio $USER
# sudo usermod -a -G i2c $USER
# Then log out and back in

# I2C permissions (Linux)
# If you get I2C permission errors, run:
# sudo chmod a+rw /dev/i2c-*
# Or add persistent udev rule:
# sudo sh -c 'echo "SUBSYSTEM==\"i2c-dev\", MODE=\"0666\"" > /etc/udev/rules.d/99-i2c.rules'
# sudo udevadm control --reload-rules && sudo udevadm trigger
