<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vtitan_state_machine</name>
  <version>0.1.0</version>
  <description>WRO 2026 Future Engineers — race state machine and telemetry bridge (orchestration)</description>
  <maintainer email="inquiries@ralvarez.dev">Ramón Álvarez</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <!-- Intentionally no <test_depend>: tests run via pixi/pytest (see
       platform/robot/tests/), not colcon/ament_lint -- ruff is this repo's
       chosen linter, so ament_flake8/ament_pep257 would just be a redundant,
       differently-configured second linter rather than a real test gate. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
