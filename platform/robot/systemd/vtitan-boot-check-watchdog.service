[Unit]
Description=vTitan — BOOT_CHECK watchdog (recovers matched-but-silent DDS participants)
After=vtitan-pi5.service

[Service]
Type=oneshot
# Root: needs to restart other systemd units. The ros2 check itself drops
# to __TARGET_USER__ internally (runuser) since the pixi/ROS2 env is owned
# by that user, not root.
User=root
# Invoked through bash rather than executed directly, matching how every
# other script in this repo is called -- they are all mode 644 in git.
# Executing by path would make this unit depend on an executable bit that a
# plain `git pull` silently reverts.
ExecStart=/bin/bash __TARGET_HOME__/vtitan/platform/robot/scripts/provisioning/boot-check-watchdog.sh __TARGET_HOME__/vtitan/platform/robot __TARGET_USER__
# Bounded so a wedged check can never pin the timer indefinitely.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
