[Unit]
Description=vTitan Pi Zero — Motors, Button, OLED
# No network-online.target: everything this unit drives (motors, button, OLED,
# challenge-mode jumper) is local GPIO/I2C/PWM. Gating on it made boot time
# hostage to NetworkManager-wait-online, which measured 6-60s (sometimes
# timing out outright) depending on the already-flaky USB gadget link to the
# Pi 5 -- see usb-gadget-link-nondeterministic notes. Networked components
# (gRPC telemetry) are already best-effort and must not gate the robot; this
# unit shouldn't be either.
#
# No dev-gpiochip0.device either (2026-08-02, found while verifying the
# network-online.target removal above on real hardware): Raspberry Pi OS's
# default udev rules never tag GPIO chardevs for systemd tracking (confirmed
# via `udevadm info -q property /dev/gpiochip0` -- no TAGS=... with
# "systemd"), so that .device unit can never become "active" on its own and
# After= on it always burns the full ~90s device-job timeout every boot,
# regardless of how fast the hardware is actually ready (measured
# USEC_INITIALIZED=15s). It was invisible before because the
# network-online.target wait usually took just as long, so removing only
# that one made this the new bottleneck instead of fixing anything. The
# driver layer already retries transient hardware-not-ready failures
# (Restart=on-failure below), so no device-unit dependency is needed here.
StartLimitBurst=5
StartLimitIntervalSec=30

[Service]
Type=exec
User=__TARGET_USER__
Group=__TARGET_USER__
WorkingDirectory=__TARGET_HOME__/vtitan/platform/robot
Environment=PATH=__TARGET_HOME__/.pixi/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-__TARGET_HOME__/vtitan/platform/robot/.env
Environment=ROS_DOMAIN_ID=0
# See docs/dds-shm-transport-disabled.md and the matching comment in
# vtitan-pi5.service.
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=__TARGET_HOME__/vtitan/platform/robot/config/fastdds_udp_only.xml
# launch-rpi-zero (not a raw "ros2 launch") -- the pixi task sources
# ros2_ws/install/setup.bash first, which is required to resolve the
# locally-built vtitan_drivers and vtitan_bringup packages.
# --as-is (= --no-install --frozen): the dev env is fully managed by
# deploy-dev-env-to-zero.sh's tarball swap -- every boot should use exactly
# what's already installed, never touch the lock file or re-verify/fetch
# packages. Re-deploy explicitly (deploy-dev-env-to-zero.sh) to pick up
# changes instead of relying on this to self-heal.
ExecStart=__TARGET_HOME__/.pixi/bin/pixi run --as-is -e dev launch-rpi-zero
Restart=on-failure
RestartSec=3
ExecStop=/usr/bin/kill -SIGINT $MAINPID
TimeoutStopSec=5
# Runs after the main process exits, for ANY reason -- clean stop, timeout
# escalation, or a crash/OOM-kill -- which a plain ExecStop cannot cover.
# LPWM/R_EN/L_EN (BTS7960 drive H-bridge) are plain GPIOs that gpiozero
# releases the instant this process's file descriptors close; released, they
# float and the module's 3.3V<->5V logic-level shifter's onboard ~10kOhm
# pull-up (confirmed with a multimeter) pulls them HIGH -- which drove the
# motor at full speed in reverse on a plain `systemctl stop`, confirmed on
# hardware 2026-08-27 (see docs/bts7960-ibt2-wiring.md). This re-drives them
# low within systemd's own reaction time instead of leaving them floating
# until the next boot's connect() call, which can be 10+ seconds away.
# __MOTOR_L_EN_PIN__/__MOTOR_R_EN_PIN__/__MOTOR_REVERSE_PIN__ are templated by
# bootstrap-fresh-zero.sh from the same MOTOR_L_EN_PIN/MOTOR_R_EN_PIN/
# MOTOR_REVERSE_PIN shell vars it uses for config.txt's gpio=...=op,dl line --
# both must match config/hardware/motors/bts7960.toml's l_en_pin/r_en_pin/
# reverse_pwm_pin, or a future rewire silently re-drives the WRONG (now
# unused) pins low here while leaving the real ones unprotected. Guarded on
# DRIVE_BACKEND so this is a no-op on L298N/Build HAT deployments, where
# these pins may be unused or wired to something else entirely. Does NOT
# cover a raw power loss/kernel panic that bypasses systemd entirely -- only
# a physical pull-down resistor on LPWM closes that gap (not yet installed
# as of 2026-08-27).
ExecStopPost=/bin/sh -c '[ "$DRIVE_BACKEND" = "bts7960" ] && /usr/bin/pinctrl set __MOTOR_L_EN_PIN__,__MOTOR_R_EN_PIN__,__MOTOR_REVERSE_PIN__ op dl || true'

[Install]
WantedBy=multi-user.target
