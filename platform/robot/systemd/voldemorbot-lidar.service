[Unit]
Description=Voldemorbot — RPLiDAR C1
Wants=dev-ttyUSB0.device
After=dev-ttyUSB0.device

[Service]
Type=exec
User=__TARGET_USER__
Group=__TARGET_USER__
Environment=PATH=__TARGET_HOME__/.pixi/bin:/usr/local/bin:/usr/bin:/bin
Environment=ROS_DOMAIN_ID=0
ExecStart=__TARGET_HOME__/.pixi/bin/pixi run -e dev ros2 launch sllidar_ros2 sllidar_c1_launch.py serial_port:=/dev/ttyUSB0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=voldemorbot-pi5.service
