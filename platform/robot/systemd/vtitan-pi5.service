[Unit]
Description=vTitan Pi 5 — State Machine, Vision, IMU, LiDAR, Bridge
# No network-online.target: same reasoning as vtitan-pi-zero.service's own
# comment on this -- NetworkManager-wait-online measured 6-60s on this
# hardware, and nothing this unit drives actually needs WiFi to start.
# hailort/LiDAR are local hardware; telemetry to the backend is already
# best-effort and must never gate the robot; the OLED's IP-address line
# already has its own fetch-with-timeout fallback ("FETCHING..."/"OFFLINE").
# This unit runs state_machine_node, whose 60s jumper-read timeout races the
# gadget-link settle time (see wait-for-gadget-link.sh) -- gating boot on a
# WiFi wait that can itself run 6-60s was directly eating into that race.
Wants=hailort.service vtitan-lidar.service
After=hailort.service vtitan-lidar.service
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
User=__TARGET_USER__
Group=__TARGET_USER__
WorkingDirectory=__TARGET_HOME__/vtitan/platform/robot
Environment=PATH=__TARGET_HOME__/.pixi/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-__TARGET_HOME__/vtitan/platform/robot/.env
Environment=ROS_DOMAIN_ID=0
# See docs/dds-shm-transport-disabled.md: FastDDS's default SHM transport
# accumulates stale /dev/shm/fastdds_* lock files across systemd restarts,
# which silently blocks discovery/delivery for whichever participant lands
# on a wedged port -- no error, no exception, the subscription just never
# receives anything. UDP-only removes the failure mode at its source.
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=__TARGET_HOME__/vtitan/platform/config/fastdds_udp_only.xml
# A Pi 5 reboot power-cycles the Zero too (it draws power over the same USB
# gadget cable) -- there is no "just the Pi 5 rebooted" on this hardware,
# every Pi 5 boot is a simultaneous cold boot of both boards. Without this,
# state_machine_node's own 60s jumper-read timeout starts immediately and
# races the gadget link's re-enumeration instead of running against an
# already-stable link. Bounded (55s) and never fails/blocks startup on its
# own -- see the script for the full rationale.
ExecStartPre=/bin/bash __TARGET_HOME__/vtitan/platform/robot/scripts/provisioning/wait-for-gadget-link.sh
# Restart vtitan-lidar.service fresh right before launching, rather than
# reusing the instance that's been running since early boot (~30s before
# this point). Confirmed on hardware 2026-08-10 via a standalone `ros2 topic
# hz /scan` probe running throughout a cold boot: /scan kept flowing at a
# clean 10Hz the entire time sllidar_node sat "matched but silent" from
# state_machine_node's point of view, so the LiDAR/DDS link itself was never
# broken -- only state_machine_node's specific subscription to a long-
# quiescent participant it was discovering late, in the same instant 4 other
# heavy processes (vision/telemetry/IMU too) were all launching and
# registering dozens of endpoints at once. The boot-check-watchdog already
# proved that restarting sllidar_node together with this unit reliably
# clears it -- this does that proactively on every boot instead of waiting
# ~90-140s for the watchdog to notice and do it reactively. Needs root
# (the "+" prefix), since this unit itself runs as an unprivileged user.
ExecStartPre=+/usr/bin/systemctl restart vtitan-lidar.service
# launch-rpi5 (not a raw "ros2 launch") -- the pixi task sources
# ros2_ws/install/setup.bash first, which is required to resolve the
# locally-built vtitan_state_machine/vtitan_vision/vtitan_drivers
# and vtitan_bringup packages.
ExecStart=__TARGET_HOME__/.pixi/bin/pixi run -e vision launch-rpi5
Restart=on-failure
RestartSec=5
ExecStop=/usr/bin/kill -SIGINT $MAINPID
TimeoutStopSec=10
# Default TimeoutStartSec (90s) leaves too little margin once the 55s
# ExecStartPre wait is added on top of the ROS2 stack's own startup time.
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
