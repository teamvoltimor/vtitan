<?xml version="1.0"?>
<!-- Hand-maintained copy of platform/config/robot.toml's values. Previously generated by
     `simgen generate-robot-constants` (removed 2026-09-03, unused and its output was broken);
     edit this file directly and keep it in sync with robot.toml -- see
     platform/robot/docs/robot-physical-constants.md. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Chassis properties (vTitan) -->
  <xacro:property name="chassis_length" value="0.3"/>
  <xacro:property name="chassis_width" value="0.194"/>
  <xacro:property name="chassis_height" value="0.1"/>
  <xacro:property name="chassis_mass" value="1.3"/>

  <!-- Ackermann geometry -->
  <xacro:property name="wheelbase" value="0.19"/>
  <xacro:property name="track_width" value="0.1675"/>
  <xacro:property name="max_steering_angle" value="0.9599310885968813"/>
  <xacro:property name="rear_steer_ratio" value="1.0"/>

  <!-- Wheel properties -->
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.05"/>

  <!-- Sensor mount offsets -->
  <xacro:property name="lidar_mount_x" value="0.1222"/>
  <xacro:property name="lidar_mount_z" value="0.02"/>
  <xacro:property name="lidar_mount_yaw_offset_deg" value="180.0"/>
  <xacro:property name="imu_mount_z" value="0.01"/>
  <xacro:property name="camera_mount_x" value="0.1222"/>
  <xacro:property name="camera_mount_z" value="0.16"/>
  <xacro:property name="camera_mount_pitch" value="0.5236"/>

</robot>
