<?xml version="1.0"?>
<robot name="wro_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Chassis properties (LEGO Bugatti Bolide) -- measured 2026-07-11, see
       ../../../robot/docs/robot-physical-constants.md. Must match
       platform/shared/src/shared/config/constants.py's RobotSpecs -- kept in sync by hand,
       there is no single source of truth across Python/xacro/the Go SDF generator yet. -->
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width" value="0.20"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass" value="0.8"/>

  <!-- Ackermann geometry -->
  <xacro:property name="wheelbase" value="0.19"/>
  <xacro:property name="track_width" value="0.1675"/>
  <xacro:property name="max_steering_angle" value="0.5236"/>

  <!-- Wheel properties -->
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.05"/>

  <!-- Sensor mount offsets. lidar_mount_x = chassis_length/2 - lidar_link's own mesh radius
       (0.0278, see below): the C1 mounted flush with the front edge. camera_mount_x/z/pitch
       are an estimate pending a real measurement -- see RobotSpecs.CAMERA_MOUNT_* in
       constants.py. Must match RobotSpecs.LIDAR_MOUNT_X_OFFSET / CAMERA_MOUNT_*. -->
  <xacro:property name="lidar_mount_x" value="0.1222"/>
  <xacro:property name="camera_mount_x" value="0.1222"/>
  <xacro:property name="camera_mount_z" value="0.16"/>
  <xacro:property name="camera_mount_pitch" value="0.5236"/>  <!-- ~30 degrees, tilted down -->

  <!-- Derived properties -->
  <xacro:property name="half_wheelbase" value="${wheelbase / 2}"/>
  <xacro:property name="half_track" value="${track_width / 2}"/>

  <!-- Base link (chassis) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(1.0/12.0) * chassis_mass * (chassis_width*chassis_width + chassis_height*chassis_height)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * chassis_mass * (chassis_length*chassis_length + chassis_height*chassis_height)}"
        iyz="0.0"
        izz="${(1.0/12.0) * chassis_mass * (chassis_length*chassis_length + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- Footprint link (for navigation) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ====== FRONT WHEELS (Steering) ====== -->

  <!-- Wheel macro for visual/collision/inertial -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="dark_rubber">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <inertia
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0.0"
          izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Steering hinge link (massless) -->
  <xacro:macro name="steering_link" params="name">
    <link name="${name}">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                 iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Front-left steering assembly -->
  <xacro:steering_link name="front_left_steering"/>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering"/>
    <origin xyz="${half_wheelbase} ${half_track} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steering_angle}" upper="${max_steering_angle}" effort="10" velocity="3.0"/>
  </joint>

  <xacro:wheel_link name="front_left_wheel"/>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front-right steering assembly -->
  <xacro:steering_link name="front_right_steering"/>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering"/>
    <origin xyz="${half_wheelbase} ${-half_track} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steering_angle}" upper="${max_steering_angle}" effort="10" velocity="3.0"/>
  </joint>

  <xacro:wheel_link name="front_right_wheel"/>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ====== REAR WHEELS (Drive) ====== -->

  <xacro:wheel_link name="rear_left_wheel"/>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="${-half_wheelbase} ${half_track} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel_link name="rear_right_wheel"/>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="${-half_wheelbase} ${-half_track} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ====== SENSORS ====== -->

  <!-- Camera (RPi Camera 3 Wide: 102 deg HFOV, 1536x864) -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.024 0.024 0.012"/>
      </geometry>
      <material name="camera_color">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.024 0.024 0.012"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_mount_x} 0 ${camera_mount_z}" rpy="0 ${camera_mount_pitch} 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.7802</horizontal_fov>
        <image>
          <width>1536</width>
          <height>864</height>
          <format>RGB8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/wro_robot</namespace>
          <remapping>~/image_raw:=/camera/image_raw</remapping>
          <remapping>~/camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
        <hack_baseline>0.0</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- LiDAR (Slamtec C1: 0.05-12m, ~500 samples, 360 deg) -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.0278" length="0.0413"/>
      </geometry>
      <material name="lidar_color">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0278" length="0.0413"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.110"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0" izz="0.00004"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- z = chassis_height + 0.02 = 0.12: matches static_tfs.launch.py / the Go SDF
         generator's RobotHeight + RobotLidarZOffset. Previously chassis_height/2 + 0.025
         = 0.075 here only -- a pre-existing drift from those other two sources, found
         and fixed alongside the mount-offset measurements (see
         platform/robot/docs/robot-physical-constants.md). -->
    <origin xyz="${lidar_mount_x} 0 ${chassis_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_ray">
      <update_rate>10.0</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>500</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.03</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/wro_robot</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU (BNO085) -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.0256 0.0227 0.0046"/>
      </geometry>
      <material name="imu_color">
        <color rgba="0.0 0.4 0.0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.0025"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.054</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.054</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.054</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.3</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.3</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.3</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/wro_robot</namespace>
          <remapping>~/out:=/imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ====== ACKERMANN STEERING CONTROLLER ====== -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <kingpin_width>${track_width}</kingpin_width>
      <topic>/wro_robot/cmd_vel</topic>
      <odom_topic>/wro_robot/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50.0</odom_publish_frequency>
      <max_steering_angle>${max_steering_angle}</max_steering_angle>
    </plugin>
  </gazebo>

  <!-- ====== GAZEBO MATERIALS ====== -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="front_left_wheel">
    <material>Gazebo/DarkGray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <material>Gazebo/DarkGray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <material>Gazebo/DarkGray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="rear_right_wheel">
    <material>Gazebo/DarkGray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

</robot>
