<?xml version="1.0"?>
<!--
  WRO Future Engineers 2026 — Robot URDF
  Used by RViz and the ROS2 TF tree. Poses match the Gazebo SDF model in
  simulation/src/generation/sdf_robot_builder.py.

  Coordinate convention: base_link origin at ground-wheel contact plane centre.
    - x forward, y left, z up (REP-103)
  All dimensions in metres.
-->
<robot name="wro_robot">

  <!-- ───────────────────────── base_link ───────────────────────────────── -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.15 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.15 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.001825" iyy="0.005293" izz="0.006133"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ─────────────────────── camera_link ──────────────────────────────── -->
  <!-- Front-top of chassis: x = LENGTH/2 = 0.14, z = HEIGHT = 0.10       -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.14 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- ────────────────────── lidar_link (laser_frame) ─────────────────── -->
  <!-- Centred on top of chassis: z = HEIGHT + 0.02 = 0.12               -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.040"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ─────────────────────── imu_link ─────────────────────────────────── -->
  <!-- Just above base_link bottom: z = 0.01                              -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0256 0.0227 0.0046"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.4 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.0025"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
  </joint>

</robot>
