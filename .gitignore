.pypirc

# Claude Code
.claude/
CLAUDE.md

# OpenCode
opencode.json

# Internal programs configuration
.rsk/

# Shared data tree, split by provenance (live = pulled off the robot,
# sim = sim-runner output), each with runs/videos/photos siblings. Both the
# Python and Go stacks reference this, never the robot module's own dir.
# Large binary data, never committed; the .gitkeep markers are tracked.
data/live/runs/*
!data/live/runs/.gitkeep
data/live/videos/*
!data/live/videos/.gitkeep
data/live/photos/*
!data/live/photos/.gitkeep
# Simulator-recorded bags (sim-runner --record). Kept apart from
# data/live/ because a single 640-case sweep writes ~1.2 GB across 640
# bags, and burying the handful of expensive real track runs under that is
# how one gets deleted by accident.
data/sim/runs/*
!data/sim/runs/.gitkeep
data/sim/videos/*
!data/sim/videos/.gitkeep
data/sim/photos/*
!data/sim/photos/.gitkeep

# Internal docs
docs/internal/

# Debug recordings pulled off the robot by task robot:record-vision
platform/robot/vision-*.mp4

# Pinned-seed sweep corpus (task gen:corpus) — regenerated, never committed.
platform/robot/.corpus/

# Captured stdout of the scripts/sim/diag_*.py sweeps. Each file is one run's
# tables under one profile, kept only to diff the next run against; a sweep is
# reproducible from its script, seed and profile, so none of it is history.
.diag/

# Landing page
landing/

# alias scan artifact
.alias_scan.json

# Parity-gate dumps: one .txt per gate run (gates_*, o128_*, o256_*/obs256_*,
# obs_*, s_*, latch_*, latchsweep_*), kept only to eyeball a single run;
# reproducible from the gate script + profile, so never committed.
/gates_*.txt
/o128_*.txt
/obs256_*.txt
/obs_*.txt
/s_*.txt
/latch_*.txt
/latchsweep_*.txt

# Generated doc artifacts (rendered SVGs) — sources are the mermaid/png
# siblings that are tracked; these are build output.
docs/schemes/flowcharts/common/svg-editorial/
# NOT docs/schemes/wiring/ as a whole: the harness schematic exports
# (harness.schematic.png/.svg) ARE committed, because they are what the WRO
# judges read and rebuilding them needs the whole tscircuit toolchain. The
# toolchain's own throwaway output stays ignored by the nested
# docs/schemes/wiring/tscircuit/.gitignore.
